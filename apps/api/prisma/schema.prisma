// Schéma initial — étape 0
// Quatre modèles : Application (le client), Endpoint (destination + secret),
// Event (l'événement), DeliveryAttempt (traçabilité des tentatives, étape 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Le client du service : une application émettrice (ex. "Facturio").
model Application {
  id         String   @id @default(cuid())
  name       String
  // On stocke un hash de la clé API, jamais la clé en clair.
  // La clé n'est montrée qu'une fois à la création (comme Stripe/GitHub).
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())

  endpoints Endpoint[]
  events    Event[]
}

// Une destination de livraison : l'URL d'un destinataire final.
model Endpoint {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  url         String
  // Secret HMAC propre à cet endpoint, utilisé pour signer chaque livraison (étape 4).
  secret      String
  description String?
  // Désactiver un endpoint stoppe les livraisons sans le supprimer (l'historique reste).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  events Event[]

  @@index([applicationId])
}

enum EventStatus {
  PENDING // accepté, pas encore tenté
  RETRYING // au moins un échec, réessai planifié
  DELIVERED // livré (2xx reçu du destinataire)
  FAILED // épuisement des tentatives → dead letter
}

// Un événement à livrer. C'est LA table centrale : source de vérité (ADR-001).
model Event {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  endpointId    String
  endpoint      Endpoint    @relation(fields: [endpointId], references: [id])

  // Type métier fourni par le client, ex. "invoice.paid".
  type    String
  payload Json

  // Idempotence côté ingestion : si le client renvoie le même couple
  // (application, clé), on ne crée PAS de second événement.
  // La contrainte unique en base fait le travail — pas de logique applicative fragile.
  idempotencyKey String?

  status        EventStatus @default(PENDING)
  attemptCount  Int         @default(0)
  // Prochaine tentative planifiée (backoff). Null si DELIVERED ou FAILED.
  nextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DeliveryAttempt[]

  @@unique([applicationId, idempotencyKey])
  // Pour le worker et le cron de réconciliation : "les événements à traiter".
  @@index([status, nextAttemptAt])
  // Pour le dashboard : liste paginée par application, triée par date.
  @@index([applicationId, createdAt])
}

// Une tentative de livraison d'un Event. Table d'ajout seul (append-only) :
// une ligne par essai, jamais mise à jour — c'est la timeline du dashboard (étape 6).
model DeliveryAttempt {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // 1 pour le premier essai, incrémenté à chaque retry (backoff, étape 3).
  attemptNumber Int

  // Code HTTP reçu du destinataire. Null si aucune réponse (timeout, DNS,
  // connexion refusée...) — dans ce cas `error` porte le détail.
  statusCode Int?
  // Vrai si un 2xx a été reçu ; dérivé mais stocké pour ne pas rejouer la
  // logique de succès à chaque lecture (dashboard, métriques étape 7).
  success    Boolean
  // Durée de la tentative en millisecondes, du départ de la requête à la
  // réponse ou au timeout (timeout strict de 5s, voir PLAN.md étape 2).
  durationMs Int

  // Réponse du destinataire, tronquée (ex. 2 Ko) pour ne pas gonfler la table.
  responseBody String?
  // Message d'erreur si `statusCode` est null (timeout, erreur réseau).
  error        String?

  createdAt DateTime @default(now())

  // Pour la timeline d'un événement, dans l'ordre chronologique.
  @@index([eventId, attemptNumber])
}
